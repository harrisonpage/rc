"""

    html += """    </div>
</body>
</html>
"""

    with open("preview.html", "w") as f:
        f.write(html)

    print("Generated preview.html")


# --- cli -------------------------------------------------------------------

def main():
    args = sys.argv[1:]
    colors = load_colors()

    if not args:
        color_name = random.choice(list(colors.keys()))
        set_terminal_color(colors[color_name])
        print(colors[color_name])
        return

    search_term = args[0]

    if search_term == "preview":
        generate_preview()
        return

    if search_term in ("-v", "-version", "--version", "version"):
        print(VERSION)
        return

    if search_term in ("--list", "list", "help", "--help", "-h", "-help"):
        print(f"Available colors: {', '.join(sorted(colors.keys()))}")
        return

    if search_term == "reset":
        if is_apple_terminal():
            print("Error: reset is not supported under Terminal.app",
                  file=sys.stderr)
            sys.exit(1)
        if not reset_colors_osc():
            print("Error: could not talk to the terminal", file=sys.stderr)
            sys.exit(1)
        return

    if search_term in ("light", "dark"):
        is_dark = search_term == "dark"
        filtered = {name: value for name, value in colors.items()
                    if (calculate_luminance(value) <= 0.08) == is_dark}
        if not filtered:
            print(f"Error: no {search_term} colors in the palette",
                  file=sys.stderr)
            sys.exit(1)
        color_name = random.choice(list(filtered.keys()))
    elif search_term in colors:
        color_name = search_term
    else:
        matches = [name for name in colors if search_term in name]
        if not matches:
            print(f"Error: No colors matching '{search_term}'")
            print(f"Available colors: {', '.join(sorted(colors.keys()))}")
            sys.exit(1)
        color_name = random.choice(matches)

    set_terminal_color(colors[color_name])
    print(colors[color_name])


if __name__ == "__main__":
    main()
