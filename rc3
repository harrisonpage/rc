        }
    </style>
</head>
<body>
    <h1>rc3 Color Palette</h1>
    <div class="container">
"""

    for name, color_hex in load_colors().items():
        text_color = get_contrasting_text_color(color_hex)

        html += f"""        <div class="swatch">
            <div class="color-box" style="background-color: #{color_hex};">
                <div class="preview-text" style="color: #{text_color};">
$ ls -la<br>
total 42<br>
drwxr-xr-x
                </div>
            </div>
