}

VERSION = "rc 3.1.0 (06-Nov-2026)"


def load_colors():
    """Colors from COLORS_FILE, parsed the way Fledermaus parses it:
    bad lines skipped, the first of a repeated name wins."""
    try:
        with open(COLORS_FILE, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        return COLORS
    colors = {}
    seen = set()
    for line in lines:
        fields = line.split()
        if len(fields) < 2 or fields[0].startswith("#"):
            continue
        name, value = fields[0], fields[1]
        if value.startswith("#"):
            value = value[1:]
        if (len(value) == 6 and all(c in string.hexdigits for c in value)
                and name.lower() not in seen):
            seen.add(name.lower())
            colors[name] = value
    return colors or COLORS


def calculate_luminance(color_hex):
    """Calculate relative luminance of a color (0-1 scale)"""
    r = int(color_hex[0:2], 16) / 255
    g = int(color_hex[2:4], 16) / 255
    b = int(color_hex[4:6], 16) / 255

    def adjust(c):
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4

    r = adjust(r)
    g = adjust(g)
    b = adjust(b)

    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def get_contrasting_text_color(bg_color_hex):
    """Returns black or white hex based on background luminance"""
    return "000000" if calculate_luminance(bg_color_hex) > 0.5 else "FFFFFF"


# --- terminal plumbing -----------------------------------------------------

def passthrough(seq):
    """Wrap an escape sequence so it survives tmux or screen."""
    if os.environ.get("TMUX"):
        return "\033Ptmux;" + seq.replace("\033", "\033\033") + "\033\\"
    if os.environ.get("TERM", "").startswith("screen"):
        return "\033P" + seq + "\033\\"
    return seq


def write_tty(data):
    """Write to the controlling terminal, not stdout, so piping still works."""
    try:
        with open("/dev/tty", "w") as tty:
            tty.write(data)
            tty.flush()
        return True
    except OSError:
        return False


def set_colors_osc(bg_hex, fg_hex):
    """Set background (OSC 11), foreground (OSC 10) and cursor (OSC 12)."""
    seqs = (
        passthrough(f"\033]11;#{bg_hex}\007")
        + passthrough(f"\033]10;#{fg_hex}\007")
        + passthrough(f"\033]12;#{fg_hex}\007")
    )
    return write_tty(seqs)


def reset_colors_osc():
    """Reset foreground/background/cursor to the profile defaults."""
    seqs = (
        passthrough("\033]110\007")
        + passthrough("\033]111\007")
        + passthrough("\033]112\007")
    )
    return write_tty(seqs)


def set_colors_applescript(bg_hex, fg_hex):
    """Terminal.app ignores OSC 10/11, so drive it via AppleScript."""
    bg_r, bg_g, bg_b = (int(bg_hex[i:i + 2], 16) * 257 for i in (0, 2, 4))
    fg_r, fg_g, fg_b = (int(fg_hex[i:i + 2], 16) * 257 for i in (0, 2, 4))
    transparency = -5000

    script = f"""
tell application "terminal"
        tell window 1
                set background color to {{{bg_r}, {bg_g}, {bg_b}, {transparency}}}
                set normal text color to {{{fg_r}, {fg_g}, {fg_b}, {transparency}}}
        end tell
end tell
"""
    p = os.popen("/usr/bin/osascript", "w")
    p.write(script)
    return p.close() is None


def is_apple_terminal():
    return os.environ.get("TERM_PROGRAM") == "Apple_Terminal"


def set_terminal_color(color_hex):
    """Set the terminal background and an appropriate foreground color"""
    fg_hex = get_contrasting_text_color(color_hex)

    if is_apple_terminal():
        ok = set_colors_applescript(color_hex, fg_hex)
    else:
        ok = set_colors_osc(color_hex, fg_hex)

    if not ok:
        print("Error: could not talk to the terminal", file=sys.stderr)
        sys.exit(1)


