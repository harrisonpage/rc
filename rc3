#!/usr/bin/env python3
"""rc3 - set the terminal background to a curated color.

Uses OSC escape sequences (terminal-native, works over ssh, works in
Ghostty/kitty/WezTerm/Alacritty) and falls back to AppleScript when
running under Terminal.app, which does not honor OSC 10/11.
"""

import os
import random
import string
import sys

# Shared with Fledermaus (Cmd-R, View > Colors). Each line: name, then hex;
# "#" lines are comments (section headings in Fledermaus's menu).
COLORS_FILE = os.path.expanduser("~/.config/fledermaus/colors.txt")

